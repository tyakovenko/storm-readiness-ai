# Files `gcloud run deploy --source .` uploads to Cloud Build (gitignore syntax).
# Without this file gcloud falls back to .gitignore, which drops data/raw/ and with it the
# Census county boundaries the outage model needs. Keep in step with .dockerignore.
.gcloudignore
.git
.gitignore
.env
**/.env
.venv/
**/__pycache__/
**/node_modules/
frontend/dist/
presentation/
docs/
project-log.md
CLAUDE.md
.claude/
**/*.pdf
# All local data except the county boundaries (a parent directory can't be re-included
# once excluded, so each level is excluded with /* and the path back in is re-included).
data/*
!data/raw/
data/raw/*
!data/raw/census/
data/raw/census/*
!data/raw/census/counties/
