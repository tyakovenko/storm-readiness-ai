# Never ship secrets, local data, or internal notes in the image.
.env
**/.env
.git
**/.venv
**/__pycache__
**/node_modules
frontend/dist
# All local data except the Census county boundaries the outage model needs (~18 MB, public data,
# no GCS copy). Each level is excluded with /* so the path back in can be re-included.
data/*
!data/raw/
data/raw/*
!data/raw/census/
data/raw/census/*
!data/raw/census/counties/
presentation/
project-log.md
.claude/
docs/
**/*.pdf
