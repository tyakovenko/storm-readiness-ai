# Copy to the repo root as .env (gitignored) and fill in. Never commit a real key.

# Scripted demo, no key needed:
LLM_MODEL=mock

# Real model through LiteLLM (swap provider by changing this one line):
# LLM_MODEL=gemini/gemini-flash-latest
# GEMINI_API_KEY=...
# Or Vertex AI (GCP):
# LLM_MODEL=vertex_ai/gemini-flash-latest
# LLM_MODEL=anthropic/claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...

# Optional actionable-check judge (non-blocking). Unset -> reported "not configured".
# JUDGE_MODEL=anthropic/claude-haiku-4-5-20251001

# ---- Dallas (default AGENT_DOMAIN) ----
# AGENT_DOMAIN=dallas            # or "hurricane" for the original stub loop
# Dallas agent on Gemini via Vertex (uses gcloud application-default credentials, no key):
# LLM_MODEL=gemini-3.8-flash
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=uc3-storm-impact-intelligence
# GOOGLE_CLOUD_LOCATION=global   # gemini-3.8-flash is only served at "global"
# JUDGE_MODEL=gemini-2.5-flash   # bare Gemini id -> Vertex judge, no key
# DALLAS_LIVE_ALERTS=on          # "off" = always the labeled scenario (tests, offline demo)
# Data: python data/sync_cloud_data.py pull --dataset dallas && pull --dataset oni,
#       then from backend/: python -m dallas.build  (or the app reads processed/dallas from GCS)
